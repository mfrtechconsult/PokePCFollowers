{
  "title": "PokéPC Followers Mod",
  "summary": "All 251 Gen 1 and Gen 2 overworld followers with Crystal 251 and voxel/tilt compatibility.",
  "author": "Antigravity & gamecorner33",
  "version": "0.6.0",
  "tags": [
    "graphics",
    "followers",
